@model IEnumerable<QuickDrop.Models.Restaurant>
@{ ViewData["Title"] = "Home"; }

<!-- HERO -->
<section class="hero">
  <div class="container">
	<div class="row align-items-center">
	  <div class="col-lg-6">
		<span class="badge qd-badge mb-3">FOOD · DELIVERY · TRACKING</span>
		<h1 class="reveal">Good Food. <br><span>Fast Delivery.</span></h1>
		<p class="lead text-muted-light reveal">QuickDrop connects customers, restaurants and drivers in one unified platform — order from your favorite local spots and get food delivered fast.</p>

		<div class="d-flex gap-2 mt-4 reveal">
		  <a href="/Customer/Index" class="qd-btn">Order Now</a>
		  <a href="/Customer/Index" class="qd-btn ghost">Explore Restaurants</a>
		</div>

		<!-- Search (small on hero) -->
		<form class="searchbar mt-4 reveal" method="get" action="/">
		  <span style="display:inline-grid;place-items:center;padding:0 10px;color:var(--white)">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="11" cy="11" r="6" stroke="currentColor" stroke-width="1.6"/></svg>
		  </span>
		  <input name="q" value="@ViewBag.Query" placeholder="Search restaurants, meals or cuisines..." />
		  <button type="submit">Search</button>
		</form>
	  </div>

	  <div class="col-lg-6 d-none d-lg-block">
		<div class="position-relative">
			<img src="@(Model?.FirstOrDefault()?.ImageUrl ?? "/images/hero-food.jpg")" alt="Featured food" onerror="this.onerror=null;this.src='/images/hero-food.jpg';" style="width:100%;border-radius:16px;box-shadow:0 20px 60px rgba(24,8,60,0.5);height:420px;object-fit:cover" class="reveal" />
		  <div class="hero-blob blob-1"></div>
		  <div class="hero-blob blob-2"></div>
		</div>
	  </div>
	</div>
  </div>
</section>

<!-- CATEGORIES -->
<section id="categories" class="category-strip py-4" aria-labelledby="category-heading">
  <div class="container">
	<div class="d-flex justify-content-between align-items-center mb-3">
	  <div>
		<span class="eyebrow">EXPLORE YOUR CRAVINGS</span>
		<h2 id="category-heading" class="mb-0">What are you in the mood for?</h2>
	  </div>
	</div>
	<div class="category-grid">
	  @foreach (var category in new[] { ("🍔", "Burgers"), ("🍕", "Pizza"), ("🍣", "Asian"), ("🥗", "Healthy"), ("🍰", "Desserts"), ("☕", "Drinks") })
	  {
		<a class="category-tile" href="/?q=@category.Item2">
		  <span class="category-icon" aria-hidden="true">@category.Item1</span>
		  <span>@category.Item2</span>
		</a>
	  }
	</div>
  </div>
</section>

<!-- POPULAR / SEARCH -->
<section class="py-5">
  <div class="container">
	<div class="d-flex justify-content-between align-items-center mb-4">
	  <h2 class="reveal">Popular restaurants</h2>
	  <a class="qd-btn ghost" href="/Account/Login">Sign in to order</a>
	</div>

	<div class="restaurant-grid">
	  @foreach (var r in Model ?? Enumerable.Empty<QuickDrop.Models.Restaurant>())
	  {
		<div class="restaurant-card reveal">
		  <img src="@r.ImageUrl" alt="@r.Name" loading="lazy" onerror="this.onerror=null;this.src='/images/restaurant-placeholder.jpg';" />
		  <div class="card-body">
			<h5 style="color:var(--white);margin-bottom:6px">@r.Name</h5>
			<p class="text-muted small" style="margin-bottom:8px">@r.Cuisine</p>
			<div class="d-flex justify-content-between align-items-center mb-2">
			  <div class="small text-muted-light">⭐ 4.5</div>
			  <div class="small text-muted-light">25-35 min · $3.99</div>
			</div>
			<a class="qd-btn w-100" href="/Customer/Restaurant/@r.Id">View Restaurant</a>
		  </div>
		</div>
	  }
	</div>
  </div>
</section>

<!-- POPULAR FOOD -->
<section class="py-2">
  <div class="container">
	<div class="d-flex justify-content-between align-items-center mb-3">
	  <h3 class="reveal">Popular food</h3>
	  <a href="/Customer/Index" class="qd-btn ghost">See all</a>
	</div>

	<div class="food-grid">
	  @{
		var foods = (Model ?? Enumerable.Empty<QuickDrop.Models.Restaurant>())
			.SelectMany(r => r.Products.Select(p => new { Product = p, Restaurant = r }))
			.Take(8)
			.ToList();
	  }
	  @if (!foods.Any()) {
		<div class="empty-state">No popular items yet — explore restaurants to find tasty meals.</div>
	  } else {
		foreach (var item in foods) {
		  <div class="card glass product-card reveal" style="padding:0;">
			<img src="@(string.IsNullOrWhiteSpace(item.Product.ImageUrl) ? item.Restaurant.ImageUrl : item.Product.ImageUrl)" alt="@item.Product.Name" loading="lazy" onerror="this.onerror=null;this.src='/images/food-placeholder.jpg';" style="width:100%;height:140px;object-fit:cover;border-top-left-radius:12px;border-top-right-radius:12px" />
		    <div style="padding:12px">
				<strong style="color:var(--white)">@item.Product.Name</strong>
				<div class="small text-muted-light">@item.Restaurant.Name · @($"{item.Product.Price:C}")</div>
				<div class="d-flex justify-content-between align-items-center mt-2">
				  <div class="small text-muted-light">⭐ 4.6</div>
				  <a class="qd-btn" href="/Customer/Restaurant/@item.Restaurant.Id">Add</a>
				</div>
			  </div>
			</div>
		}
	  }
	</div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="py-5">
  <div class="container">
	<div class="text-center mb-4">
	  <h3 class="reveal">How QuickDrop works</h3>
	  <p class="text-muted-light">Fast, simple and reliable — from order to delivery.</p>
	</div>
	<div class="dash-grid">
	  <div class="dash-card reveal">
		<h5>1. Choose your food</h5>
		<p class="text-muted-light">Browse restaurants and add tasty meals to your cart.</p>
	  </div>
	  <div class="dash-card reveal">
		<h5>2. Place your order</h5>
		<p class="text-muted-light">Checkout with your preferred payment method.</p>
	  </div>
	  <div class="dash-card reveal">
		<h5>3. Track your driver</h5>
		<p class="text-muted-light">Follow your delivery in real time.</p>
	  </div>
	  <div class="dash-card reveal">
		<h5>4. Enjoy your meal</h5>
		<p class="text-muted-light">Delicious food delivered to your door.</p>
	  </div>
	</div>
  </div>
</section>

<!-- PROMOTIONAL BANNER -->
<section style="padding:48px 0;background:linear-gradient(135deg,var(--purple-primary),var(--purple-electric));margin-top:18px;border-radius:12px;">
  <div class="container text-center text-white">
	<h2>Craving something delicious?</h2>
	<p class="text-white-50">Find great deals from nearby restaurants and enjoy fast delivery.</p>
	<a class="qd-btn mt-2" href="/Customer/Index">Order Now</a>
  </div>
</section>

<!-- FOOTER -->
<footer class="py-5 mt-5" style="background:linear-gradient(180deg,rgba(0,0,0,0.3),transparent);">
  <div class="container">
	<div class="row">
	  <div class="col-md-4">
		<h4 style="color:var(--white)">QuickDrop</h4>
		<p class="small text-muted-light">Fast delivery from local favorites. Demo platform.</p>
	  </div>
	  <div class="col-md-2">
		<h6 style="color:var(--white)">Customer</h6>
		<ul class="list-unstyled small">
		  <li><a href="/Customer/Index">Browse restaurants</a></li>
		  <li><a href="/Account/Login">Login</a></li>
		</ul>
	  </div>
	  <div class="col-md-2">
		<h6 style="color:var(--white)">Restaurants</h6>
		<ul class="list-unstyled small">
		  <li><a href="/Restaurant/Index">Partner with us</a></li>
		</ul>
	  </div>
	  <div class="col-md-2">
		<h6 style="color:var(--white)">Drivers</h6>
		<ul class="list-unstyled small">
		  <li><a href="/Driver/Index">Driver portal</a></li>
		</ul>
	  </div>
	  <div class="col-md-2 text-end">
		<div class="small text-muted-light">Follow</div>
		<div class="d-flex gap-2 justify-content-end mt-2">
		  <a class="nav-icon" href="#" aria-label="Twitter">T</a>
		  <a class="nav-icon" href="#" aria-label="Facebook">f</a>
		</div>
	  </div>
	</div>
	<div class="text-center small text-muted-light mt-4">© @DateTime.UtcNow.Year QuickDrop · Demo platform</div>
  </div>
</footer>
