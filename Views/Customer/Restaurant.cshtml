@model QuickDrop.Models.Restaurant
@{ ViewData["Title"] = Model.Name; }

<div class="restaurant-page">
  <!-- Cover -->
  <div class="restaurant-cover" style="background-image:url('@Model.ImageUrl')">
	<div class="cover-overlay"></div>
	<div class="container py-5">
	  <div class="d-flex align-items-end gap-3">
		<div style="width:120px;height:120px;flex:0 0 120px">
		  <img src="@(Model.ImageUrl)" alt="@Model.Name" style="width:100%;height:100%;object-fit:cover;border-radius:18px;border:4px solid rgba(255,255,255,0.06)" />
		</div>
		<div>
		  <h1 style="color:var(--white);margin:0">@Model.Name</h1>
		  <div class="d-flex gap-3 align-items-center mt-2">
			<span class="badge qd-badge">@Model.Cuisine</span>
			<div class="small text-muted-light">⭐ 4.5</div>
			<div class="small text-muted-light">· 25-35 min</div>
			<div class="small text-muted-light">· UGX 3,000 delivery</div>
			<div class="status" style="margin-left:8px">@(Model.IsOpen ? "OPEN" : "CLOSED")</div>
		  </div>
		  <p class="text-muted-light mt-2">@Model.Address</p>
		</div>
	  </div>
	</div>
  </div>

  <div class="container py-4">
	<!-- Category Navigation -->
	<nav class="mb-3">
	  <ul class="nav category-nav">
		@{
		  var cats = new List<string>{"Popular","Meals","Burgers","Pizza","Drinks","Desserts"};
		}
		@foreach(var c in cats){
		  <li class="nav-item"><a href="#" class="nav-link category-link" data-cat="@c">@c</a></li>
		}
	  </ul>
	</nav>

	<!-- Products grid -->
	<div class="row g-4" id="product-grid">
	  @foreach(var p in Model.Products)
	  {
		var cat = string.IsNullOrWhiteSpace(p.Category) ? "Meals" : p.Category;
		<div class="col-12 col-md-6 col-lg-4 product-item" data-category="@cat">
		  <div class="card product-card h-100 glass">
			<div style="position:relative;overflow:hidden;border-top-left-radius:12px;border-top-right-radius:12px">
			  <img src="@p.ImageUrl" alt="@p.Name" style="width:100%;height:220px;object-fit:cover;display:block" />
			</div>
			<div class="card-body">
			  <div class="d-flex justify-content-between align-items-start">
				<div>
				  <h5 style="color:var(--white);margin:0">@p.Name</h5>
				  <p class="small text-muted-light mb-2">@p.Description</p>
				</div>
				<div style="text-align:right">
				  <div style="color:var(--white);font-weight:700">UGX @p.Price.ToString("N0")</div>
				  <div class="small text-muted-light">⭐ 4.6</div>
				</div>
			  </div>

			  <form method="post" action="/Customer/PlaceOrder" class="mt-3">
				@Html.AntiForgeryToken()
				<input type="hidden" name="productId" value="@p.Id" />
				<input type="hidden" name="quantity" value="1" />
				<div class="d-flex gap-2">
				  <input class="form-control-dark" name="deliveryAddress" placeholder="Delivery address" required />
				  <select class="form-control-dark" name="paymentMethod"><option value="Cash">Cash</option><option value="Card">Card</option></select>
				</div>
				<button class="qd-btn w-100 mt-3">Add to Cart</button>
			  </form>
			</div>
		  </div>
		</div>
	  }
	</div>
  </div>

  <!-- Floating cart for mobile -->
  <a href="/Customer/Index" class="floating-cart" aria-label="Cart">
	<div class="nav-icon" style="border-radius:999px;padding:12px;">🛒</div>
  </a>
</div>
